# Copy to .env and replace the local development password.
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=playerdna
DB_USER=playerdna_app
DB_PASSWORD=replace-with-a-local-secret

# Optional alternative to DB_* variables:
# DATABASE_URL=postgresql+psycopg://playerdna_app:replace-with-a-local-secret@127.0.0.1:5432/playerdna

# Exact origins; no wildcard is allowed.
PLAYERDNA_CORS_ORIGINS=http://localhost:5173,http://localhost:3000
PLAYERDNA_GAME_TIME_SECONDS=300
PLAYERDNA_GAME_INCREMENT_SECONDS=0
# Set true when serving the frontend and API over HTTPS.
PLAYERDNA_COOKIE_SECURE=false
